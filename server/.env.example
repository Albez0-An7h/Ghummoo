# Copy to server/.env. Nothing here is required for local development.

PORT=5050

# MongoDB. Leave unset to use the embedded local database (stored in server/.data and
# seeded automatically). Set it for production, e.g. a free MongoDB Atlas cluster:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/ghumo

# Seed demo data automatically when the database is empty. Defaults to on for the
# embedded DB. Set it to "true" to also seed an empty external database on first boot.
# SEED_ON_EMPTY=true

# Required in production. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API (only needed when the client
# is hosted on a different origin from the API).
CLIENT_URL=http://localhost:5173

# AI Package Studio (server-side only, never exposed to the browser).
# Option A: Anthropic
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Option B: any OpenAI-compatible API (OpenAI, Gemini's OpenAI endpoint, Groq, etc.)
# AI_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Option C: Google Gemini (uses its OpenAI-compatible endpoint, key from aistudio.google.com)
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-gemini-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest
# Optional model override. A comma-separated list is tried in order when a model is busy.
# AI_MODEL=

# Where uploaded package photos are stored (default: server/uploads)
# UPLOAD_DIR=
